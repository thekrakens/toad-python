# TOAD Configuration Example
# Copy this file to .env and fill in your actual values

# Notion API Configuration
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_main_database_id

# Productivity Module Databases
NOTION_TASKS_DATABASE_ID=your_tasks_database_id
NOTION_TIME_ENTRIES_DATABASE_ID=your_time_entries_database_id
NOTION_DAILY_METRICS_DATABASE_ID=your_daily_metrics_database_id
NOTION_TIME_BLOCKS_DATABASE_ID=your_time_blocks_database_id

# Health Module Databases
NOTION_HABITS_DATABASE_ID=2042579666bd81bf969cd7cfb068264e
NOTION_WORKOUTS_DATABASE_ID=your_workouts_database_id_here
NOTION_HEALTH_STATS_DATABASE_ID=2042579666bd811d9d93d6e2426550ec

# Workout Sync Paths (iCloud Drive)
# Use ~/iCloud shortcut (symlink created) or full path
WORKOUT_SYNC_INBOX_PATH=/Users/YOUR_USERNAME/iCloud/TOAD/workout_sync/inbox
WORKOUT_SYNC_PROCESSED_PATH=/Users/YOUR_USERNAME/iCloud/TOAD/workout_sync/processed
WORKOUT_SYNC_FAILED_PATH=/Users/YOUR_USERNAME/iCloud/TOAD/workout_sync/failed

# LLM API Keys (Optional)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here

# Ollama Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
